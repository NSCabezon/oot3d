#!/bin/sh
# Generated by CMake: run a Windows RVCT tool through wibo (macOS: wibo-macos under Rosetta 2).
# armcc runs armasm via "%COMSPEC% /c ..." for embedded __asm functions; cmdshim provides a PE cmd.exe.
PATH="@CMAKE_SOURCE_DIR@/tools/macos/cmdshim:$PATH"
export PATH
# Opt-in content-addressed object cache (decomp-spike/scripts/armcc_cache.sh): armcc only, and only when
# ARMCC_CACHE_DIR is exported (mkws.sh / rebuild_check.sh do). The cache script re-runs this wrapper with
# ARMCC_CACHE_DIR cleared on a miss.
if [ "@armtool@" = armcc ] && [ -n "$ARMCC_CACHE_DIR" ]; then
    armcc_cache="${ARMCC_CACHE_SH:-$ARMCC_CACHE_DIR/../scripts/armcc_cache.sh}"
    [ -x "$armcc_cache" ] && exec "$armcc_cache" "$0" "$@"
fi
exec "@WIBO@" "@TOOL@" "$@"
