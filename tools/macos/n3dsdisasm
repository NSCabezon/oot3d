#!/bin/sh
# macOS shim: run the repo's Linux x86-64 n3dsdisasm inside a linux/amd64 container (colima/docker/OrbStack).
# Under colima's QEMU user-mode emulation this is slow (one-time step); with OrbStack/Rosetta it is much faster.
# usage (same as n3dsdisasm): n3dsdisasm -c CFG code.bin  > out.s
HERE=$(cd "$(dirname "$0")/../.." && pwd)
exec docker run --rm -i --platform linux/amd64 -v "$HERE":"$HERE" -w "$PWD" ubuntu:24.04 \
    "$HERE/disassembly/tools/n3dsdisasm" "$@"
